# Sol Mate Frontend — Environment Variables
# Copy to .env.local and fill in values

# API
NEXT_PUBLIC_API_URL=https://sol-mate-trust-api-production.up.railway.app

# Solana
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Coinbase x402 (Base USDC payments)
NEXT_PUBLIC_X402_ENABLED=false
NEXT_PUBLIC_BASE_NETWORK=base-mainnet

# Feature flags
NEXT_PUBLIC_ENABLE_MOMENT_NFTS=true
NEXT_PUBLIC_ENABLE_SOL_GIFTS=true
